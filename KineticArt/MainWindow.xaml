<Window x:Class="KineticArt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KineticArt"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition />

            <ColumnDefinition Width="290"/>

        </Grid.ColumnDefinitions>

        <Canvas
        Name="DrawingCanvas"
        Grid.Column="0"
        Background="Black"/>

        <StackPanel
        Grid.Column="1"
        Margin="10,10,10,10">

            <Button
        x:Name="btnPause"
        Content="Pause"
                FontSize="14"
        Margin="2"
        Click="btnPause_Click"/>

            <Button
                x:Name="btnReset"
                Content="Reset"
                FontSize="14"
                Margin="2"
                Click="btnReset_Click"/>

            <Button
                x:Name="btnSavePattern"
                Content="Save Pattern"
                FontSize="14"
                Margin="2"
                Click="btnSavePattern_Click"/>

            <TextBlock
        Text="Current Rotation"
        FontSize="13"
        FontWeight="Bold"
        Margin="0,0,0,10"/>

            <Grid Height="120">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>

                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <!-- Row -->
                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- Line0 -->
                <Label Grid.Row="0"
               Grid.Column="0"
               Content="Line 0"/>

                <TextBox
            Name="txtLine0"
            Grid.Row="0"
            Grid.Column="1"
                    Tag="0"
                    TextChanged="AngleTextChanged"/>

                <!-- Square0 -->

                <Label
            Grid.Row="0"
            Grid.Column="3"
            Content="Square 0"/>

                <TextBox
            Name="txtSquare0"
            Grid.Row="0"
            Grid.Column="4"
                    Tag="4"
                    TextChanged="AngleTextChanged"/>

                <!-- Line1 -->

                <Label
            Grid.Row="1"
            Grid.Column="0"
            Content="Line 1"/>

                <TextBox
            Name="txtLine1"
            Grid.Row="1"
            Grid.Column="1"
                    Tag="1"
                    TextChanged="AngleTextChanged"/>

                <Label
            Grid.Row="1"
            Grid.Column="3"
            Content="Square 1"/>

                <TextBox
            Name="txtSquare1"
            Grid.Row="1"
            Grid.Column="4"
                    Tag="5"
                    TextChanged="AngleTextChanged"/>

                <!-- Line2 -->

                <Label
            Grid.Row="2"
            Grid.Column="0"
            Content="Line 2"/>

                <TextBox
            Name="txtLine2"
            Grid.Row="2"
            Grid.Column="1"
                    Tag="2"
                    TextChanged="AngleTextChanged"/>

                <Label
            Grid.Row="2"
            Grid.Column="3"
            Content="Square 2"/>

                <TextBox
            Name="txtSquare2"
            Grid.Row="2"
            Grid.Column="4"
                    Tag="6"
                    TextChanged="AngleTextChanged"/>

                <!-- Line3 -->

                <Label
            Grid.Row="3"
            Grid.Column="0"
            Content="Line 3"/>

                <TextBox
            Name="txtLine3"
            Grid.Row="3"
            Grid.Column="1"
                    Tag="3"
                    TextChanged="AngleTextChanged"/>

                <Label
            Grid.Row="3"
            Grid.Column="3"
            Content="Square 3"/>

                <TextBox
            Name="txtSquare3"
            Grid.Row="3"
            Grid.Column="4"
                    Tag="7"
                    TextChanged="AngleTextChanged"/>

            </Grid>

            <TextBlock
Text="Rotation Direction"
FontSize="13"
FontWeight="Bold"
Margin="0,0,0,10"/>
            <Grid Height="16">


                <Label
                    Grid.Row="0"
                    Content="Line" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right" Width="205">
                   
                </Label>

                <RadioButton
                    Grid.Column="2"
                    Grid.Row="0"
                    x:Name="Clockwise"
                    Content="CW"
                    IsChecked ="True" Margin="64,0,19,0"/>

                <RadioButton
                    Grid.Column="3"
                    Grid.Row="0"
                    x:Name="CounterClockwiwe"
                    Content="CCW"
                    IsChecked="False" Margin="135,0,19,0"/>
            </Grid>







        </StackPanel>

    </Grid>

</Window>
